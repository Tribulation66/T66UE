        {
          "Namespace": "HeroQuotes",
          "Children": [
            {
              "Source": {
                "Text": "\"Bite back.\""
              },
              "Translation": {
                "Text": "\"Bite back.\""
              },
              "Key": "Hero_10"
            },
            {
              "Source": {
                "Text": "\"Break before me.\""
              },
              "Translation": {
                "Text": "\"Break before me.\""
              },
              "Key": "Hero_3"
            },
            {
              "Source": {
                "Text": "\"Catch me first.\""
              },
              "Translation": {
                "Text": "\"Catch me first.\""
              },
              "Key": "Hero_9"
            },
            {
              "Source": {
                "Text": "\"Cold wins.\""
              },
              "Translation": {
                "Text": "\"Cold wins.\""
              },
              "Key": "Hero_14"
            },
            {
              "Source": {
                "Text": "\"Directive: survive.\""
              },
              "Translation": {
                "Text": "\"Directive: survive.\""
              },
              "Key": "Hero_7"
            },
            {
              "Source": {
                "Text": "\"Fast hands, faster kill.\""
              },
              "Translation": {
                "Text": "\"Fast hands, faster kill.\""
              },
              "Key": "Hero_8"
            },
            {
              "Source": {
                "Text": "\"Gold outlasts gods.\""
              },
              "Translation": {
                "Text": "\"Gold outlasts gods.\""
              },
              "Key": "Hero_15"
            },
            {
              "Source": {
                "Text": "\"It gets worse.\""
              },
              "Translation": {
                "Text": "\"It gets worse.\""
              },
              "Key": "Hero_13"
            },
            {
              "Source": {
                "Text": "\"Kneel to thunder.\""
              },
              "Translation": {
                "Text": "\"Kneel to thunder.\""
              },
              "Key": "Hero_6"
            },
            {
              "Source": {
                "Text": "\"Let's make it ugly.\""
              },
              "Translation": {
                "Text": "\"Let's make it ugly.\""
              },
              "Key": "Hero_4"
            },
            {
              "Source": {
                "Text": "\"Send it.\""
              },
              "Translation": {
                "Text": "\"Send it.\""
              },
              "Key": "Hero_12"
            },
            {
              "Source": {
                "Text": "\"Stand your ground.\""
              },
              "Translation": {
                "Text": "\"Stand your ground.\""
              },
              "Key": "Hero_1"
            },
            {
              "Source": {
                "Text": "\"Stay sharp.\""
              },
              "Translation": {
                "Text": "\"Stay sharp.\""
              },
              "Key": "Hero_5"
            },
            {
              "Source": {
                "Text": "\"The storm obeys.\""
              },
              "Translation": {
                "Text": "\"The storm obeys.\""
              },
              "Key": "Hero_2"
            },
            {
              "Source": {
                "Text": "\"Unlucky for them.\""
              },
              "Translation": {
                "Text": "\"Unlucky for them.\""
              },
              "Key": "Hero_16"
            },
            {
              "Source": {
                "Text": "\"You won't see dawn.\""
              },
              "Translation": {
                "Text": "\"You won't see dawn.\""
              },
              "Key": "Hero_11"
            }
          ]
        },
